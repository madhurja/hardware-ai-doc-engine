.env
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
*.log
tools/

# CRITICAL: Prevent proprietary client source, schematic, PCB, and generated
# deliverable files from leaking into commits.
input_drop/**/*
!input_drop/**/.gitkeep
output_packages/**/*
!output_packages/.gitkeep
local_state/**/*
!local_state/.gitkeep
